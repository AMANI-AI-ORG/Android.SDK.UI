<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.amani.amani_sdk">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Apps that can pick a PDF, so the capture screen only offers its PDF upload when one
         exists (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:name="ai.amani.sample.App"
        android:theme="@style/AppTheme">
        <activity
            android:name="ai.amani.sdk.presentation.AmaniMainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="ai.amani.sdk.presentation_v2.AmaniComposeActivity"
            android:theme="@style/Theme.AmaniV2.Transparent"
            android:exported="false" />
    </application>
</manifest>