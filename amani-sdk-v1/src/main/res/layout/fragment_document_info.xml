<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="dataModel"
            type="ai.amani.sdk.model.ConfigModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        setBackgroundColor="@{dataModel.generalConfigs.appBackground}">

        <!-- Scrolls only when the two texts do not fit; a short text stays centered between the
             toolbar and the button. -->
        <ScrollView
            android:id="@+id/information_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/continue_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <ai.amani.sdk.presentation.common.CustomTextView
                    android:id="@+id/information_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rubik_500"
                    android:lineSpacingExtra="3sp"
                    android:textAlignment="center"
                    android:textSize="19sp"
                    tools:text="IBAN'ınızı iki yoldan gönderebilirsiniz: banka uygulaması ekran görüntüsü veya WhatsApp sohbeti." />

                <ai.amani.sdk.presentation.common.CustomTextView
                    android:id="@+id/information_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_document_info_card"
                    android:fontFamily="@font/rubik_400"
                    android:lineSpacingExtra="6sp"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp"
                    android:textAlignment="textStart"
                    android:textSize="15sp"
                    tools:text="YÖNTEM 1 — WhatsApp (önerilen)\n1. Banka uygulamasında IBAN Paylaş." />

            </LinearLayout>

        </ScrollView>

        <ai.amani.sdk.presentation.common.CustomButton
            android:id="@+id/continue_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/rubik_500"
            android:textAllCaps="false"
            android:textSize="@dimen/sp_18"
            app:layout_constraintBottom_toTopOf="@id/powered_by_amani"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Upload Document" />

        <ImageView
            android:id="@+id/powered_by_amani"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:layout_marginBottom="@dimen/dp_20"
            android:src="@drawable/ic_bottom_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
