<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ai.amani.sample">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc"
        android:required="true"/>
    <uses-permission android:name="android.permission.ScanNFC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:name=".App"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmaniSDKUI.NoActionBar"
        tools:replace="android:theme"
        >
        <activity
            android:name="ai.amani.sample.presentation.entry.QrEntryActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Portrait QR scanner (Compose + ZXing). -->
        <activity
            android:name="ai.amani.sample.presentation.scan.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Kept as a reference: manual token/customer entry demo (no longer the launcher). -->
        <activity
            android:name="ai.amani.sample.MainRegisterActivity"
            android:exported="false" />
    </application>

</manifest>